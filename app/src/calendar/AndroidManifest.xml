<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Bootstrap mínimo do GitHub: calendário + PIN + canal de update + install.
         Nada de relay, chat, P2P, contactos, localização, câmara ou microfone. -->
    <uses-permission android:name="android.permission.VIBRATE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" tools:node="remove" />

    <application>
        <service android:name=".service.RelayService" tools:node="remove" />
        <service android:name=".service.KeepAliveJobService" tools:node="remove" />
        <receiver android:name=".util.NotificationDismissReceiver" tools:node="remove" />
        <receiver android:name=".receiver.BootReceiver" tools:node="remove" />
        <receiver android:name=".receiver.AlarmReceiver" tools:node="remove" />
        <activity android:name=".debug.VoiceProbeActivity" tools:node="remove" />
        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name="com.journeyapps.barcodescanner.CaptureActivity" tools:node="remove" />
        <activity android:name="com.google.android.gms.common.api.GoogleApiActivity" tools:node="remove" />
        <meta-data android:name="com.google.android.gms.version" tools:node="remove" />
        <receiver android:name="androidx.profileinstaller.ProfileInstallReceiver" tools:node="remove" />

        <activity
            android:name=".bootstrap.BootstrapActivity"
            android:exported="true"
            android:theme="@style/Theme.SecMess">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
